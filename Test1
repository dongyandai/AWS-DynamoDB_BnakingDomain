        raise DynamoDBCopyException(error_msg)

def write_to_hudi_table(df, table_name, spark_session, args):
    """
    Function to write transformed data to Hudi tables
    
    Parameters:
        df: DataFrame to write
        table_name: Name of the target table
        spark_session: Spark session
        args: Job arguments
    """
    try:
        # Configure based on target table
        table_config = {
            'loan_balance_history': {
                'primary_key': 'loan_no,balance_date',
                'pre_combine_col': 'balance_date',
                'partition_field': 'year,month',
                'database': 'banking_core'
            },
            'mortgage_account_master': {
                'primary_key': 'mrtg_acct_id',
                'pre_combine_col': 'mrtg_acct_no',
                'database': 'banking_core'
            },
            'mortgage_customer': {
                'primary_key': 'mrtg_acct_id,cust_id',
                'pre_combine_col': 'updated_datetime',
                'database': 'banking_core'
            },
            'address': {
                'primary_key': 'addr_id',
                'pre_combine_col': 'created_datetime',
                'database': 'account_core'
            }
        }
        
        config = table_config.get(table_name, {})
        database = config.get('database', args.get('DEFAULT_DATABASE', 'banking_core'))
        
        # Hudi table configuration
        hudi_table_config = {
            's3_path': f"s3://{args['S3_BASE_PATH']}/{database}/{table_name}",
            'conf_table_name': table_name,
            'conf_db_name': database,
            'primary_key': config.get('primary_key', 'id'),
            'pre_combine_col': config.get('pre_combine_col', 'updated_datetime'),
            'target_encoding': 'utf-8',
            'hudi_table_type': 'COPY_ON_WRITE',
            'bulk_ins_shuffle_parallelism': 2,
            'upd_shuffle_parallelism': 2
        }
        
        # Add partition field if present
        if 'partition_field' in config:
            hudi_table_config['partition_key'] = config['partition_field']
        
        # Initialize HudiTable and start write operation
        logger.info(f"Initializing HudiTable for {table_name} and starting write operation...")
        hudi_table = HudiTable(logger, spark_session, hudi_table_config)
        
        # Choose write operation based on whether table exists
        try:
            # Check if table exists by attempting to run a simple query
            spark_session.sql(f"SELECT 1 FROM {database}.{table_name} LIMIT 1")
            # If we reach here, table exists, use upsert
            hudi_table.hudi_table_upsert(df)
            logger.info(f"Successfully upserted {df.count()} records to {database}.{table_name}")
        except Exception:
            # Table likely doesn't exist, use bulk insert
            hudi_table.hudi_table_bulk_insert(df, "overwrite")
            logger.info(f"Successfully bulk inserted {df.count()} records to {database}.{table_name}")
        
    except Exception as e:
        logger.error(f"Error in write_to_hudi_table for {table_name}: {str(e)}")
        raise DynamoDBCopyException(f"Error in write_to_hudi_table for {table_name}: {str(e)}")

if __name__ == "__main__":
    # Get job parameters
    args = getResolvedOptions(sys.argv, ["JOB_NAME",
                                        "DYNAMODB_TABLE_ARN",
                                        "S3_BUCKET_NAME",
                                        "S3_BUCKET_PREFIX",
                                        "S3_BUCKET_OWNER",
                                        "S3_BASE_PATH"])
    
    # Initialize custom logger
    logger = get_module_logger(args["JOB_NAME"])
    
    # Store job run ID for tracking
    current_job_run_id = args["JOB_RUN_ID"] if "JOB_RUN_ID" in args else "manual_run"
    
    try:
        # Set up SparkContext and GlueContext with necessary Hudi configs
        spark_conf = None
        spark_conf = SparkContext.getOrCreate().getConf().setAll([
            ('spark.serializer', 'org.apache.spark.serializer.KryoSerializer'),
            ('spark.sql.catalog.spark_catalog', 'org.apache.spark.sql.hudi.catalog.HoodieCatalog'),
            ('spark.sql.extensions', 'org.apache.spark.sql.hudi.HoodieSparkSessionExtension'),
            ('spark.sql.avro.datetimeRebaseModeInWrite', 'CORRECTED')
        ])
        
        sc = SparkContext(conf=spark_conf)
        glueContext = GlueContext(sc)
        spark = glueContext.spark_session
        job = Job(glueContext)
        job.init(args["JOB_NAME"], args)
        
        # Process loan balance data
        logger.info("Starting loan balance data transformation...")
        loan_balance_df = transform_loan_balance_data(glueContext, spark, args)
        write_to_hudi_table(loan_balance_df, 'loan_balance_history', spark, args)
        
        # Process mortgage account master data
        logger.info("Starting mortgage account master data transformation...")
        mortgage_master_df = transform_mortgage_master_data(glueContext, spark, args)
        write_to_hudi_table(mortgage_master_df, 'mortgage_account_master', spark, args)
        
        # Process customer data
        logger.info("Starting mortgage customer data transformation...")
        mortgage_customer_df = transform_mortgage_customer_data(glueContext, spark, args)
        write_to_hudi_table(mortgage_customer_df, 'mortgage_customer', spark, args)
        
        # Process address data
        logger.info("Starting address data transformation...")
        address_df = transform_address_data(glueContext, spark, args)
        write_to_hudi_table(address_df, 'address', spark, args)
        
        # Job completion
        logger.info("DynamoDB to Banking Domain migration completed successfully")
        job.commit()
        
    except Exception as e:
        logger.exception(e)
        raise e
