def transform_mortgage_customer_data(glue_context, spark_session, args):
    """
    Function to transform DynamoDB data to match the mortgage_customer table
    """
    try:
        # Read data from DynamoDB
        _, view_name = read_dynamodb_data(glue_context, spark_session, args, "customer")
        
        # Create a temp view that would simulate the banking_core.mortgage_account_master table
        # In a real scenario, you would read from the actual table
        spark_session.sql(f"""
            CREATE OR REPLACE TEMPORARY VIEW banking_core_mortgage_account_master AS
            SELECT 
                expr('1') as mrtg_acct_id,
                split(Item.PK.S, '#')[1] as mrtg_acct_no
            FROM 
                {view_name}
            WHERE 
                Item.PK.S LIKE 'Loan#%'
        """)
        
        # Transform to match mortgage_customer table schema
        # Based on Image 4 showing mortgage_customer table structure
        mortgage_customer_df = spark_session.sql("""
            SELECT
                mam.mrtg_acct_id as mrtg_acct_id,
                expr('100') as cust_id,  -- Using placeholder, would come from a join in real scenario
                'C' as cust_type,  -- Default customer type
                expr('6') as src_sys_id,
                expr('1') as curr_ind,
                current_timestamp() as eff_start_datetime,
                cast(null as timestamp) as eff_end_datetime,
                'GLUE_JOB' as created_by,
                current_timestamp() as created_datetime,
                'GLUE_JOB' as updated_by,
                current_timestamp() as updated_datetime
            FROM
                banking_core_mortgage_account_master mam
        """)
        
        logger.info(f"Transformed {mortgage_customer_df.count()} mortgage customer records")
        logger.info("Mortgage Customer DataFrame Schema:")
        mortgage_customer_df.printSchema()
        
        return mortgage_customer_df
        
    except Exception as e:
        logger.exception(e)
        error_msg = f"Error in mortgage customer transformation: {str(e)}"
        raise DynamoDBCopyException(error_msg)

def transform_address_data(glue_context, spark_session, args):
    """
    Function to transform DynamoDB data to match the address table
    """
    try:
        # Read data from DynamoDB
        _, view_name = read_dynamodb_data(glue_context, spark_session, args, "address")
        
        # Transform to match address table schema
        # Based on Images 5-6 showing the address table structure
        address_df = spark_session.sql(f"""
            SELECT
                expr('1000') as addr_id,  -- Generated ID, would be properly sequenced in real implementation
                concat(
                    coalesce(trim(Item.PropertyStreetNumber.S), ''), ' ',
                    coalesce(trim(Item.PropertyStreetDirection.S), ''), ' ',
                    coalesce(trim(Item.PropertyStreetName.S), '')
                ) as addr_line1,
                '' as addr_line2,
                '' as addr_line3,
                '' as addr_line4,
                '' as addr_line5,
                trim(Item.PropertyCityName.S) as city,
                expr('237') as cntry_id,
                trim(Item.PropertyState.S) as state,
                '' as province,
                trim(Item.PropertyZip.S) as zip_code,
                '' as frgn_zip_code,
                '' as zip_plus4,
                expr('0') as opt_out_ind,
                expr('6') as src_sys_id,
                'GLUE_JOB' as created_by,
                current_timestamp() as created_datetime,
                expr(concat("'", current_job_run_id, "'")) as glue_job_run_id
            FROM
                {view_name}
            WHERE
                Item.PK.S LIKE 'Loan#%'
        """)
        
        logger.info(f"Transformed {address_df.count()} address records")
        logger.info("Address DataFrame Schema:")
        address_df.printSchema()
        
        return address_df
        
    except Exception as e:
