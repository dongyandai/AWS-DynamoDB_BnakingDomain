class Error(Exception):
    """Base class for other exceptions"""
    pass

class DynamoDBCopyException(Error):
    pass

def get_module_logger(logger_name):
    """
    This function will create a custom logger for the glue JOB_NAME
    Parameters:
        logger_name: Name for the logger
    Returns:
        module_logger: Custom formatter logger
    """
    module_logger = logging.getLogger(logger_name)
    module_logger.setLevel(logging.INFO)
    handler = logging.StreamHandler(sys.stdout)
    formatter = logging.Formatter('%(asctime)s - %(name)s - %(levelname)s - %(message)s')
    handler.setFormatter(formatter)
    module_logger.addHandler(handler)
    return module_logger

def read_dynamodb_data(glue_context, spark_session, args, data_type):
    """
    Centralized function to read data from DynamoDB and prepare it for transformation
    
    Parameters:
        glue_context: Glue context
        spark_session: Spark session
        args: Job arguments
        data_type: Type of data being read (used for S3 path prefixing)
    
    Returns:
        DataFrame: Spark DataFrame ready for transformation
    """
    try:
        # Generate unique prefix for the DynamoDB Export
        prefix = uuid.uuid4()
        
        logger.info(f"Starting {data_type} data read from DynamoDB...")
        
        # Read data from DynamoDB
        dyf = glue_context.create_dynamic_frame.from_options(
            connection_type="dynamodb",
            connection_options={
                "dynamodb.export": "ddb",
                "dynamodb.tableArn": args["DYNAMODB_TABLE_ARN"],
                "dynamodb.s3.bucket": args["S3_BUCKET_NAME"],
                "dynamodb.s3.prefix": f"{args['S3_BUCKET_PREFIX']}/{prefix}/{data_type}",
                "dynamodb.s3.bucketOwner": args["S3_BUCKET_OWNER"],
            }
        )
        
        # Read the exported data from S3
        file_path = f"s3://{args['S3_BUCKET_NAME']}/{args['S3_BUCKET_PREFIX']}/{prefix}/{data_type}/AWSDataCatalog/data/"
        df = spark_session.read.json(file_path)
        
        # Register the dataframe as a temp view for SQL operations
        view_name = f"dynamo_data_{data_type}"
        df.createOrReplaceTempView(view_name)
        
        logger.info(f"Successfully read DynamoDB data for {data_type}")
        return df, view_name
        
    except Exception as e:
        logger.exception(e)
        error_msg = f"Error reading DynamoDB data for {data_type}: {str(e)}"
        raise DynamoDBCopyException(error_msg)

def transform_loan_balance_data(glue_context, spark_session, args):
    """
    Function to transform DynamoDB loan balance data to match the loan_balance_history table
    """
    try:
        # Read data from DynamoDB
        _, view_name = read_dynamodb_data(glue_context, spark_session, args, "balance")
        
        # Transform the data to match the loan_balance_history table schema
        # Based on Image 1 showing the loan_balance_history table structure
        loan_balance_df = spark_session.sql(f"""
            SELECT
                split(Item.PK.S, '#')[1] as loan_no,
                to_date(Item.BalanceDate.S, 'M/d/y hh:mm:ss a') as balance_date,
                cast(Item.CurrentBalance.N as decimal(19,2)) as prin_bal,
                cast(Item.EscrowBalance.N as decimal(19,2)) as escrow_bal,
                to_date(Item.PaymentDate.S, 'M/d/y hh:mm:ss a') as last_payment_date,
                year(to_date(Item.BalanceDate.S, 'M/d/y hh:mm:ss a')) as year,
                month(to_date(Item.BalanceDate.S, 'M/d/y hh:mm:ss a')) as month,
                day(to_date(Item.BalanceDate.S, 'M/d/y hh:mm:ss a')) as day
            FROM
                {view_name}
            WHERE
                Item.PK.S LIKE 'Loan#%'
        """)
        
        logger.info(f"Transformed {loan_balance_df.count()} loan balance records")
        logger.info("Loan Balance DataFrame Schema:")
        loan_balance_df.printSchema()
        
        return loan_balance_df
        
    except Exception as e:
        logger.exception(e)
        error_msg = f"Error in loan balance transformation: {str(e)}"
        raise DynamoDBCopyException(error_msg)

